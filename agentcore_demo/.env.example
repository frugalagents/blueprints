# Advisor Copilot — environment template.
# Copy to .env and fill infra values after Phase 2 deploy. Leave blank for local mode.
# Never put real guardrail/infra IDs in this file — they live in the gitignored
# .env and infra/outputs.json only.

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
GUARDRAIL_ID=
GUARDRAIL_VERSION=
GATEWAY_MCP_URL=
RUNTIME_ENDPOINT_ARN=
MEMORY_ID=

# --- Phase 3: BFF + UI wiring (local) ---
# Port the FastAPI BFF listens on (see the uvicorn command in README.md).
BFF_PORT=8000
# Base URL the React UI uses to reach the BFF. Read by ui/src/api.ts via
# import.meta.env.VITE_BFF_BASE_URL; defaults to http://localhost:8000 when unset.
VITE_BFF_BASE_URL=http://localhost:8000

# Set to "runtime" to force the BFF to call the deployed AgentCore Runtime.
CHAT_BACKEND=
